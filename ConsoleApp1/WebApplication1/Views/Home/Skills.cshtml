@{
    ViewData["Title"] = "Skills";
}

<section class="py-5">

    <div class="container">

        <div class="text-center mb-5">
            <h1 class="display-4 fw-bold">

                Technical Skills
            </h1>

            <p class="lead text-white">

                These are the tools and technologies I've learned and am still getting progressing at.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-lg-6 col-md-6 mb-4">
    <div class="card skill-card shadow border-0">

        <div class="card-body">

            <i class="bi bi-file-earmark-code text-white display-3"></i>

            <h4 class="fw-bold mt-3 text-white">
                Languages
            </h4>

            <p class="text-white">
                @ViewData["Languages"]
            </p>

        </div>

    </div>
</div>
            <div class="col-md-6 mb-4">
                <div class="card skill-card h-100 shadow-sm border-0 text-center">

                    <div class="card-body">

                        <i class="bi bi-globe text-white display-4"></i>

                        <h4 class="fw-bold mt-3 text-white">
                            Web Development
                        </h4>

                        <p class="text-white">

                            @ViewData["Framework"]
                        </p>

                    </div>

                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card skill-card h-100 shadow-sm border-0 text-center">

                    <div class="card-body">

                        <i class="bi bi-database text-white display-4"></i>

                        <h4 class="fw-bold mt-3 text-white">
                             Database
                        </h4>

                        <p class="text-white">

                            @ViewData["Database"]
                        </p>

                    </div>

                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card skill-card h-100 shadow-sm border-0 text-center">

                    <div class="card-body">

                        <i class="bi bi-tools text-white display-4"></i>

                        <h4 class="fw-bold mt-3 text-white">
                            Development Tools
                        </h4>

                        <p class="text-whit">

                            @ViewData["Developer Tools"]
                        </p>

                    </div>

                </div>
            </div>

        </div>

</section>
