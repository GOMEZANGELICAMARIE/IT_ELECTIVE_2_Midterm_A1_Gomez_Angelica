@{
    ViewData["Title"] = "About";
}

<section class="py-5">

    <div class="container">

       <div class="row mb-5">
    <div class="col-12 text-center">

        <h1 class="display-4 fw-bold text-white">
            About Me
        </h1>

        <p class="lead text-white">
            Learn more about me, my goals, education, and interests!
        </p>

    </div>
</div>
</div>
        <div class="row">

    <div class="col-lg-8 mx-auto">

        <!-- Biography Card -->
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-body p-4">

                <h3 class="text-white mb-3">
                    <i class="bi bi-person-circle me-2"></i>
                    Biography & Goals
                </h3>

                <p class="text-white">
                    @ViewData["Biography & Goals"]
                </p>

            </div>

        </div>

        <!-- Education Card -->
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-body p-4">

                <h4 class="fw-bold text-white mb-3">
                    <i class="bi bi-mortarboard-fill me-2"></i>
                    Education
                </h4>

                <p class="text-white">
                    @ViewData["Education"]
                </p>

            </div>

        </div>

        <!-- Personal Interests Card -->
        <div class="card shadow-sm border-0">

    <div class="card-body p-4">

        <h4 class="fw-bold text-white mb-3">
            <i class="bi bi-heart-fill text-white me-2"></i>
            Personal Interests
        </h4>

        <div class="d-flex flex-wrap gap-2">

            <span class="badge bg-white text-dark">Web Development</span>
            <span class="badge bg-white text-dark">VB.NET Programming</span>
            <span class="badge bg-white text-dark">Web Application Design</span>
            <span class="badge bg-white text-dark">UI Designing</span>

        </div>

    </div>

</div>

    </div>

</div>
</section>