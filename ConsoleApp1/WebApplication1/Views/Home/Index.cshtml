@{

ViewData["Title"] = "My Portfolio";

}



<!-- HOME SECTION -->
<section id="home" class="min-vh-100 d-flex align-items-center">
    <div class="container">
        <div class="row align-items-center">

            <!-- LEFT SIDE - TEXT -->
            <div class="col-lg-7 order-2 order-lg-1">

                <span class="badge bg-light text-dark">
                    Hello! Welcome to my Portfolio!
                </span>

                <h1 class="display-2 fw-bold text-white mb-3">
                    I'm Angelica Marie
                </h1>

                <h2 class="text-secondary mb-4">
                    Aspiring Software Developer
                </h2>

               <p class="lead text-white">
                    Hello! My name is Angelica Marie J. Gomez, currently a
