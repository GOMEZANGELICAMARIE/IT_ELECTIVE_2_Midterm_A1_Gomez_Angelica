@{
	ViewData["Title"] = "Projects";
}

<section class="py-5">

	<div class="container">

		<div class="text-center mb-5">

			<h1 class="display-4 fw-bold">
				My Projects
			</h1>

			<p class="lead text-white">
				These projects showcase my programming skills, technical knowledge, and hands-on experience in software development.
			</p>

		</div>


		<div class="row g-4">


			<div class="col-lg-4 col-md-6">

				<div class="card h-100 shadow-sm border-0 overflow-hidden">

					<img src="~/lib/images/studregsystem.jpg"
                         class="card-img-top"
                         style="height:200px;object-fit:cover;"
                         alt="Project Dashboard" />


					<div class="card-body d-flex flex-column">

						<h4 class="fw-bold text-dark">
							@ViewData["Project1"]
						</h4>


						<p class="text-white flex-grow-1">
							A centralized software platform designed to manage the enrollment, academic records, and scheduling of students. 
							It replaces manual, paper-based processes with automated digital workflows, allowing institutions to 
							track data securely and scale their operations efficiently
						</p>


						<div class="mb-3">

							<span class="badge bg-white">
								Visual Studio
							</span>

							<span class="badge bg-white text-dark">
								Visual Basic
							</span>

							<span class="badge bg-white text-dark">
								VB.Net
							</span>

							<span class="badge bg-white text-dark">
								Windows Forms 
							</span>
						</div>


						<button class="btn btn-outline-light text-white">
							View Details
						</button>

					</div>

				</div>

			</div>


			<div class="col-lg-4 col-md-6">

				<div class="card h-100 shadow-sm border-0 overflow-hidden">


					<img src="~/lib/images/loancalsystem.jpg"
                         class="card-img-top"
                         style="height:200px;object-fit:cover;"
                         alt="Chat Application" />


					<div class="card-body d-flex flex-column">


						<h4 class="fw-bold text-dark">
							@ViewData["Project2"]
						</h4>


						<p class="text-white flex-grow-1">
							A digital tool designed to compute and outline loan repayment schedules.
							It takes user inputs—such as the principal loan amount, annual interest rate,
							and loan term—and outputs the estimated monthly payment, total interest, and an
							amortization schedule mapping payments toward principal and interest over time.
						</p>


						<div class="mb-3">

							<span class="badge bg-white text-dark">
								Visual Studio
							</span>

							<span class="badge bg-white text-dark">
								Visual Basic
							</span>

							<span class="badge bg-white text-dark">
								VB.Net
							</span>

						</div>


						<button class="btn btn-outline-light text-white">
							View Details
						</button>


					</div>

				</div>

			</div>



			<div class="col-lg-4 col-md-6">

				<div class="card h-100 shadow-sm border-0 overflow-hidden">


					<img src="~/lib/images/atmsys.jpg"
                         class="card-img-top"
                         style="height:200px;object-fit:cover;"
                         alt="Task Management" />


					<div class="card-body d-flex flex-column">


						<h4 class="fw-bold text-dark">
							@ViewData["Project3"]
						</h4>


						<p class="text-white flex-grow-1">
							A secure, computerized telecommunications device that allows customers to perform financial transactions—such 
							as cash withdrawals, deposits, and balance inquiries—without the need of a human bank teller.
						</p>


						<div class="mb-3">

							<span class="badge bg-white">
								Visual Studio
							</span>

							<span class="badge bg-white">
								Visual Basic .NET
							</span>

							<span class="badge bg-white">
								Microsoft SQL Server
							</span>

							<span class="badge bg-white">
								Windows Forms
							</span>
							
						</div>


						<button class="btn btn-outline-light text-white">
							View Details
						</button>


					</div>

				</div>

			</div>


		</div>

	</div>


</section>